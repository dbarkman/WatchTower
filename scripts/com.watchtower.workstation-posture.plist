<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.watchtower.workstation-posture</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string>
    <string>$HOME/.local/bin/workstation-posture.sh</string></array>
  <!-- Weekly, Monday 09:00 local. RunAtLoad catches the case where the Mac was
       asleep at the scheduled time, so a missed week self-heals on next login. -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/watchtower-workstation.log</string>
  <key>StandardErrorPath</key><string>/tmp/watchtower-workstation.err</string>
</dict>
</plist>
